# ═══════════════════════════════════════════════════════════════════
# ASHA AI Hospital Voice Agent — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────
APP_NAME=Asha-AI-Hospital-Agent
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
ENABLE_PII_MASKING=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# ── Hospital Branding ─────────────────────────────────────────────────
HOSPITAL_NAME=Lifeline Multi-Speciality Hospital
HOSPITAL_CITY=Bhopal
HOSPITAL_PHONE=0755-4200-100
AGENT_NAME=Ananya

# ── LLM Providers ────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Observability: LangSmith ─────────────────────────────────────────
# Get API key from: https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asha-hospital-agent
LANGSMITH_TRACING=false

# ── Database: PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://asha:asha_dev_password@localhost:5432/asha_hospital
DB_HOST=localhost
DB_PORT=5432
DB_USER=asha
DB_PASSWORD=asha_dev_password
DB_NAME=asha_hospital
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5

# ── Cache: Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Vector DB: Qdrant ─────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud (optional):
# QDRANT_URL=https://xxxx.us-east-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=

# ── RAG / Embedding ───────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
# For TEI server offloading (optional):
# TEI_EMBEDDING_URL=http://localhost:8080/embed
# TEI_RERANK_URL=http://localhost:8081/rerank
# HF_API_TOKEN=

# ── Voice: STT (Deepgram) ─────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Telephony + SMS: Twilio ───────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── LiveKit: Browser Voice Calls ─────────────────────────────────────
# Get from: https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Email: SMTP ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=lifeline-hospital@yourdomain.com

# ── Authentication ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-secret-in-production

# ── Runtime ───────────────────────────────────────────────────────────
TTS_TEMP_FILE=static/temp_voice.mp3
