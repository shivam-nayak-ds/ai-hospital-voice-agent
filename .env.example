APP_NAME=Asha-AI-Hospital-Agent
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
ENABLE_PII_MASKING=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# LLM providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# RAG
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_DB_PATH=data/chroma_db

# Database
DATABASE_URL=postgresql+psycopg://asha:asha_dev_password@localhost:5432/asha_hospital
DB_HOST=localhost
DB_PORT=5432
DB_USER=asha
DB_PASSWORD=asha_dev_password
DB_NAME=asha_hospital
DB_POOL_SIZE=5
DB_CONNECTION_TIMEOUT=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hospital_knowledge

# Voice providers
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_REGION=centralindia
GOOGLE_APPLICATION_CREDENTIALS=
SARVAM_API_KEY=

# Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production

# Runtime files
TTS_TEMP_FILE=static/temp_voice.mp3
